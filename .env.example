# ---- GeoEstate platform ----
# LandCheck keeps its reports in Geohub's database (the `insight` schema, created on start).
DATABASE_URL=postgresql://user:password@host:5432/geohub
# Where people open LandCheck, e.g. https://check.geoestate.ng
APP_URL=http://localhost:3000
# Sign-in is through Geohub (GeoEstate ID). In Geohub's ID_CLIENTS add
#   {"id":"check","name":"LandCheck","redirect_uris":["<APP_URL>/api/auth/callback"],"secret":"<ID_SECRET>"}
# and to its PRODUCT_URLS: check=<APP_URL>
GEOHUB_URL=https://hub.example
GEOHUB_API=https://hub.example/api
ID_CLIENT=check
ID_SECRET=
# Optional (LandCheck Advanced "title status"): GeoEstate Land Registry's API and the platform key set there as PLATFORM_KEY
LAND_API=https://land.example/api
LAND_PLATFORM_KEY=

# Optional: set a MapLibre-compatible public style URL.
# Leave blank to use the built-in demo style.
NEXT_PUBLIC_MAP_STYLE_URL=

# Optional future provider configuration:
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Google Places (server-side only - do NOT prefix with NEXT_PUBLIC_). Enable "Places API (New)" in Google Cloud.
# Leave blank to use the free fallback search (project data + OpenStreetMap + Open-Meteo).
GOOGLE_MAPS_API_KEY=
# Set to 1 to turn Google search off without removing the key.
GOOGLE_PLACES_DISABLED=

# GeoAI area reports (optional; the AI-written briefing is part of LandCheck Advanced). Without a key the report text
# comes from a built-in template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
